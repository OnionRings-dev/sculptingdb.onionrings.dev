# Local PostgreSQL (Docker). Use the same password in DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sculpting:<url-encoded-password>@localhost:5432/sculpting_db

# Host bindings for compose.local.yaml only; Dokploy publishes no host ports.
# Compose builds its own DATABASE_URL using POSTGRES_PASSWORD.
APP_HOST=127.0.0.1
APP_PORT=3000
# Docker defaults to trusting HTTPS termination by your reverse proxy.
# Set false if connecting directly without a proxy.
# TRUST_PROXY=true

# Public origin of this app. Production requires HTTPS.
BETTER_AUTH_URL=http://localhost:3000
# Generate an independent random secret of at least 32 characters.
BETTER_AUTH_SECRET=

# Register a Confidential Web client in the OnionRings admin dashboard.
# Callback: http://localhost:3000/api/auth/callback/onionrings
# Post-logout callback (exact, including slash): http://localhost:3000/
# Both URLs derive from BETTER_AUTH_URL; use separate registrations per environment.
ONIONRINGS_ISSUER=https://auth.onionrings.dev/api/auth
ONIONRINGS_CLIENT_ID=
ONIONRINGS_CLIENT_SECRET=

# Optional: a separate, disposable PostgreSQL database for integration tests.
# TEST_DATABASE_URL=
